---
import { Icon } from 'astro-icon/components';
import { collectionSections } from '@/data/collections';
---

<section class="home-collections" aria-labelledby="collection-welcome">
  <div class="welcome-line">
    <span>TRAVEL / IMAGES / FAVORITES</span>
    <span class="welcome-flower" aria-hidden="true">✿</span>
  </div>
  <h2 id="collection-welcome">走过的路，遇见的光，<br />和一直喜欢的故事。</h2>
  <p class="welcome-description">你好，这里是 benmingw 的小窝。旅行、画面、作品，都想好好收藏。</p>
  <div class="collection-portals">
    {collectionSections.map((section) => (
      <a class="collection-portal" href={section.href}>
        <div class="portal-picture">
          <img src={section.image} width="800" height="500" alt="" loading="lazy" decoding="async" />
          <span class="portal-number">{section.number}</span>
        </div>
        <div class="portal-body">
          <span class="portal-english">{section.english}</span>
          <h3><Icon name={section.icon} />{section.title}<span class="portal-arrow" aria-hidden="true">↗</span></h3>
          <p>{section.description}</p>
        </div>
      </a>
    ))}
  </div>
  <p class="sample-caption">小窝正在布置中 · 当前内容为排版示例，真实的旅行和收藏会慢慢加入。</p>
</section>

<style>
  .home-collections { padding: 2px 0 24px; }
  .welcome-line { display: flex; justify-content: space-between; align-items: center; color: hsl(var(--primary)); font-size: 9px; letter-spacing: .18em; }
  .welcome-flower { font-size: 23px; opacity: .55; }
  h2 { margin: 12px 0; font-size: clamp(22px, 2.3vw, 30px); line-height: 1.7; letter-spacing: .04em; font-weight: 600; }
  .welcome-description { margin: 0; font-size: 13px; line-height: 1.9; color: hsl(var(--muted-foreground)); }
  .collection-portals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 26px; }
  .collection-portal { overflow: hidden; border: 1px solid hsl(var(--primary) / .11); border-radius: 14px; background: hsl(var(--card)); transition: transform .25s, box-shadow .25s; }
  .collection-portal:hover { transform: translateY(-5px); box-shadow: 0 12px 25px hsl(var(--primary) / .1); }
  .collection-portal:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 4px; }
  .portal-picture { aspect-ratio: 1.45; overflow: hidden; position: relative; }
  .portal-picture img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .collection-portal:hover img { transform: scale(1.045); }
  .portal-number { position: absolute; left: 12px; top: 10px; color: white; font-size: 11px; letter-spacing: .1em; text-shadow: 0 1px 8px #0007; }
  .portal-body { padding: 16px 14px 18px; }
  .portal-english { color: hsl(var(--primary)); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }
  h3 { display: flex; align-items: center; gap: 6px; margin: 8px 0; font-size: 16px; font-weight: 600; }
  h3 svg { width: 16px; }
  .portal-arrow { margin-left: auto; color: hsl(var(--primary)); font-size: 18px; }
  .portal-body p { margin: 0; font-size: 12px; line-height: 1.9; color: hsl(var(--muted-foreground)); }
  .sample-caption { margin-top: 17px; color: hsl(var(--muted-foreground)); font-size: 10px; line-height: 1.8; opacity: .8; }
  @media (max-width: 600px) {
    .collection-portals { grid-template-columns: 1fr; gap: 12px; }
    .collection-portal { display: grid; grid-template-columns: 36% 1fr; }
    .portal-picture { height: 100%; aspect-ratio: auto; min-height: 130px; }
    .portal-body { align-self: center; }
    h2 { font-size: 23px; }
  }
  @media (prefers-reduced-motion: reduce) { .collection-portal, .portal-picture img { transition: none; } .collection-portal:hover { transform: none; } }
</style>
