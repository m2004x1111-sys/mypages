---
import { getSortedPosts } from '@lib/content';
import { getRelatedPosts, hasSimilarityData } from '@lib/content/similarities';
import { toPostRefWithCategory } from '@lib/content/transforms';
import type { BlogPost } from 'types/blog';
import { getLocaleFromUrl } from '@/i18n';
import RelatedPostList from './RelatedPostList';

interface Props {
  post?: BlogPost;
}

const { post } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);

// Only show actual related articles; pages without matches have no recommendation block.
const relatedPosts =
  post && hasSimilarityData() ? getRelatedPosts(post, await getSortedPosts(locale), 5).map(toPostRefWithCategory) : [];
---

{relatedPosts.length > 0 && (
  <div class="px-10 md:px-6">
    <RelatedPostList posts={relatedPosts} locale={locale} />
  </div>
)}
