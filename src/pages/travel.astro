---
import { getCollection } from 'astro:content';
import CollectionPage from '@components/collections/CollectionPage.astro';
import GalleryGrid from '@components/collections/GalleryGrid.astro';
import PostList from '@components/post/PostList.astro';
import TravelExplorer from '@components/travel/TravelExplorer.astro';
import { toPostCardDataList } from '@lib/content/transforms';
import { travelGalleryImages } from '@/data/collections';
import { defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}
const { locale = defaultLocale } = Astro.props;
const entries = (
  await getCollection('blog', ({ data }) => !data.draft && (data.categories?.flat().includes('旅行') ?? false))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = toPostCardDataList(entries, locale);
---
<CollectionPage title="旅行日志" english="Somewhere, along the way" description="慢慢点亮地图ing~" locale={locale}>
  <TravelExplorer>
    <section id="travel-photos" aria-labelledby="travel-photos-title">
      <h3 id="travel-photos-title" class="travel-section-title">东京0，1</h3>
      <GalleryGrid images={travelGalleryImages} label="东京旅行照片" showFilters={false} description="***" />
    </section>
    <h3 class="travel-section-title travel-posts-title">旅行手记</h3>
    <PostList posts={posts} showPaginator={false} />
    <p class="travel-end">下一段旅程，留在下一页。</p>
  </TravelExplorer>
</CollectionPage>
<style>
  .travel-section-title { margin: 0 0 18px; font-size: 18px; font-weight: 600; letter-spacing: .06em; }
  .travel-posts-title { margin-top: 36px; }
  .travel-end { margin-top: 32px; color: hsl(var(--muted-foreground)); text-align: center; font-size: 12px; letter-spacing: .12em; }
</style>
